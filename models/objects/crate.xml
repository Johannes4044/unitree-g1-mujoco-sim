<mujoco model="crate">
  <!-- Plywood tote crate, 300 x 220 x 180 mm outside, 1.20 kg (the goal doc targets a crate
       under 1.5 kg). Both short walls have a rectangular cut-out handle (110 x 35 mm, 20 mm
       below the rim), built from a lower panel, two posts and a top rail, so a hand can
       actually reach through. Inertia is computed by the compiler from the panel layout, which
       is what makes it swing like a hollow box rather than a solid brick.
       Origin at the bottom centre. Self-authored primitive (CC0). -->
  <asset>
    <material name="mat" rgba="0.62 0.47 0.30 1"/>
  </asset>
  <worldbody>
    <body name="crate">
      <freejoint/>
      <geom name="bottom" type="box" size="0.15 0.11 0.006" pos="0 0 0.006" mass="0.30"
            material="mat" condim="4" friction="0.9 0.02 0.0005" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_py" type="box" size="0.15 0.006 0.084" pos="0 0.104 0.096" mass="0.25"
            material="mat" condim="4" friction="0.9 0.02 0.0005" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_ny" type="box" size="0.15 0.006 0.084" pos="0 -0.104 0.096" mass="0.25"
            material="mat" condim="4" friction="0.9 0.02 0.0005" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <!-- +x short wall: lower panel / two posts / top rail leave a 110 x 35 mm handle hole -->
      <geom name="wall_px_low" type="box" size="0.006 0.104 0.0565" pos="0.144 0 0.0685" mass="0.13"
            material="mat" condim="4" friction="0.9 0.02 0.0005" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_px_post_py" type="box" size="0.006 0.0245 0.0175" pos="0.144 0.0795 0.1425" mass="0.015"
            material="mat" condim="4" friction="0.9 0.02 0.0005"/>
      <geom name="wall_px_post_ny" type="box" size="0.006 0.0245 0.0175" pos="0.144 -0.0795 0.1425" mass="0.015"
            material="mat" condim="4" friction="0.9 0.02 0.0005"/>
      <geom name="wall_px_rail" type="box" size="0.006 0.104 0.010" pos="0.144 0 0.170" mass="0.04"
            material="mat" condim="4" friction="0.9 0.02 0.0005"/>
      <!-- -x short wall -->
      <geom name="wall_nx_low" type="box" size="0.006 0.104 0.0565" pos="-0.144 0 0.0685" mass="0.13"
            material="mat" condim="4" friction="0.9 0.02 0.0005" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_nx_post_py" type="box" size="0.006 0.0245 0.0175" pos="-0.144 0.0795 0.1425" mass="0.015"
            material="mat" condim="4" friction="0.9 0.02 0.0005"/>
      <geom name="wall_nx_post_ny" type="box" size="0.006 0.0245 0.0175" pos="-0.144 -0.0795 0.1425" mass="0.015"
            material="mat" condim="4" friction="0.9 0.02 0.0005"/>
      <geom name="wall_nx_rail" type="box" size="0.006 0.104 0.010" pos="-0.144 0 0.170" mass="0.04"
            material="mat" condim="4" friction="0.9 0.02 0.0005"/>
    </body>
  </worldbody>
</mujoco>
