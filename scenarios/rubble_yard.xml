<scenario name="rubble_yard">
  <doc>
    Uneven ground and low debris - the project's stretch goal. A 5 x 5 m patch of tiles between
    1 and 8 cm high, each tilted by up to 3 degrees, with planks and bricks lying on it and two
    kerb steps at the far end; beyond the rubble a field bench with the pickable objects, so an
    episode is "cross the broken ground, then work". The robot spawns on flat ground and meets
    the rubble after 0.8 m. Terrain is static boxes, not a heightfield, so it costs `ngeom` and
    nothing else, and it is deterministic per scenario (seed attribute) unless the whole scenario
    is built with --seed.
  </doc>

  <floor rgba="0.42 0.40 0.36 1"/>

  <terrain name="rubble" area="0.8 -2.5 5.8 2.5" tile="0.5" height="0.08" tilt="0.05"
           keepout="0 0 1.3" seed="4" rgba="0.46 0.44 0.40 1"/>

  <!-- kerb steps out of the rubble field -->
  <box name="step_low"  size="0.35 1.6 0.06" pos="6.2 -0.6 0.06" rgba="0.55 0.54 0.52 1"/>
  <box name="step_high" size="0.35 1.6 0.12" pos="6.9 -0.6 0.12" rgba="0.55 0.54 0.52 1"/>

  <!-- scenery debris: static, so the runtime randomiser leaves it where it is.
       on="rubble" means z is measured from the terrain surface under (x, y), not from the floor. -->
  <part type="plank" name="plank_a" pos="2.1 0.9 0.0" yaw="0.5" on="rubble"/>
  <part type="plank" name="plank_b" pos="3.6 -1.1 0.0" yaw="-1.1" on="rubble"/>
  <part type="brick" name="brick_a" pos="1.7 -0.6 0.0" yaw="0.8" on="rubble"/>
  <part type="brick" name="brick_b" pos="2.9 0.2 0.0" yaw="-0.4" on="rubble"/>
  <part type="brick" name="brick_c" pos="4.4 1.0 0.0" yaw="1.9" on="rubble" optional="0.6"/>
  <part type="pallet" name="pallet_a" pos="4.9 -1.9 0.0" yaw="0.2" on="rubble"/>

  <!-- two loose bricks: kickable, and the thing to clear off the path -->
  <object type="brick" name="loose_brick_a" pos="2.4 -0.15 0.005" yaw="0.3" on="rubble" jitter="0.15" yaw_jitter="3.14"/>
  <object type="brick" name="loose_brick_b" pos="3.9 0.45 0.005" yaw="-0.9" on="rubble" jitter="0.15" yaw_jitter="3.14"/>

  <!-- field bench past the rubble -->
  <part type="work_table" name="pick_table" pos="7.9 0.6 0" yaw="1.5708"/>   <!-- x 7.30..8.50, y 0.25..0.95 -->
  <part type="tote"       name="tote"       pos="7.9 -0.9 0"/>

  <object type="crate"      name="crate"      pos="7.90 0.80 0.75" jitter="0.05" yaw_jitter="0.4"/>
  <object type="cube"       name="green_cube" pos="7.70 0.42 0.75" rgba="0.15 0.65 0.25 1" jitter="0.05" yaw_jitter="3.14"/>
  <object type="can"        name="blue_can"   pos="8.05 0.40 0.75" jitter="0.05"/>

  <camera name="third_person"  pos="-1.2 -3.2 2.2" target="3.2 0 0.5" fovy="55"/>
  <camera name="overhead_pick" pos="7.9 0.6 3.0" target="7.9 0.6 0.75" fovy="55"/>
  <camera name="scene_wide"    pos="-2.0 -5.0 3.5" target="4.0 0 0.6" fovy="60"/>
</scenario>
