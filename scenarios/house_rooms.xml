<scenario name="house_rooms">
  <doc>
    Three-room house with two doorways: the robot starts in the living room, walks through a
    1.0 m doorway into the kitchen and can carry an object on through a second 0.95 m doorway
    into the store room. Built for navigation, LiDAR mapping and door traversal - the "walking
    through a different house" case - and for mobile manipulation: the pick surface is the
    kitchen counter at 0.90 m, five metres away from where the robot spawns, so the episode has
    to include locomotion before the grasp. Walls are 2.5 m high and closed at the top of the
    doorways, which is what makes the Mid-360 return a room shape rather than open sky.
  </doc>

  <floor rgba="0.55 0.50 0.44 1"/>

  <!-- outer shell -->
  <wall name="south" from="-2 -3" to="7 -3" height="2.5" thickness="0.12"/>
  <wall name="north" from="-2 3"  to="7 3"  height="2.5" thickness="0.12"/>
  <wall name="west"  from="-2 -3" to="-2 3" height="2.5" thickness="0.12"/>
  <wall name="east"  from="7 -3"  to="7 3"  height="2.5" thickness="0.12"/>
  <!-- living room | kitchen+store, doorway at y = 0 -->
  <wall name="hall"  from="2 -3" to="2 3" height="2.5" thickness="0.12" door="3.0 1.0" rgba="0.80 0.78 0.72 1"/>
  <!-- kitchen | store room, doorway at x = 4 -->
  <wall name="inner" from="2 0.5" to="7 0.5" height="2.5" thickness="0.12" door="2.0 0.95" rgba="0.80 0.78 0.72 1"/>

  <!-- living room -->
  <part type="work_table" name="dining_table" pos="1.0 -1.8 0" yaw="1.5708"/>
  <part type="chair"      name="chair_a"      pos="1.0 -1.0 0" yaw="1.5708"/>
  <part type="chair"      name="chair_b"      pos="1.0 -2.6 0" yaw="-1.5708"/>
  <part type="shelf_unit" name="bookshelf"    pos="-1.7 1.2 0" yaw="1.5708"/>

  <!-- kitchen: the counter is the randomisation surface, so it must be called pick_table.
       yaw=pi/2 puts its 1.6 m length along x (footprint x 4.70..6.30, y 2.30..2.90): with yaw=0
       the counter would run through the north wall, and its 0.6 m depth would be the only axis
       objects could spread along. -->
  <part type="counter"    name="pick_table"   pos="5.5 2.6 0" yaw="1.5708"/>
  <part type="tote"       name="tote"         pos="4.4 1.3 0"/>

  <!-- z = 0.90 is the worktop. Every object is inside the footprint with room for its own
       jitter, and clear of its neighbours' footprints, so nothing is shoved or falls on load. -->
  <object type="bottle" name="water_bottle" pos="4.90 2.50 0.90" jitter="0.06" optional="0.7"/>
  <object type="cube"   name="green_cube"   pos="5.15 2.72 0.90" rgba="0.15 0.65 0.25 1" jitter="0.06" yaw_jitter="3.14"/>
  <object type="crate"  name="crate"        pos="5.55 2.60 0.90" yaw="1.5708" jitter="0.05" yaw_jitter="0.5"/>
  <object type="cube"   name="red_cube"     pos="5.95 2.48 0.90" rgba="0.85 0.12 0.12 1" jitter="0.06" yaw_jitter="3.14"/>
  <object type="can"    name="blue_can"     pos="6.15 2.72 0.90" jitter="0.06"/>

  <!-- store room -->
  <part type="shelf_unit"  name="store_shelf" pos="6.6 -2.0 0" yaw="1.5708"/>
  <part type="crate_heavy" name="store_crate" pos="3.2 -2.2 0" yaw="0.3"/>
  <part type="chair"       name="chair_c"     pos="3.0 -0.6 0" yaw="2.4" optional="0.5"/>

  <camera name="third_person"  pos="2.5 -1.0 9.0" target="2.5 0.0 0.0" fovy="60"/>
  <camera name="overhead_pick" pos="5.5 2.0 3.2"  target="5.5 2.6 0.9" fovy="55"/>
  <camera name="scene_wide"    pos="-3.5 -6.0 4.0" target="2.5 0 1.0" fovy="55"/>
</scenario>
